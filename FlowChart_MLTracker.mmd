%%{init: {
  'theme': 'neutral',
  "themeVariables": {
    "fontSize": "20px"
  },
  "flowchart": {
    "defaultRenderer": "elk",
    "nodeSpacing": 20,
    "rankSpacing": 30
  }
}}%%

flowchart LR

    subgraph User["User"]
        InputNC[("Input NetCDF<br>Climate data")]
        MLParameters["<b>MLParameters</b>"]
    end

    subgraph MLTracker["MLTracker"]
        direction TB
        Preprocess["**preprocess**<br>e.g. normalise fields,<br>extract features"]
        Detect["**detect**<br>run the ML model<br>output candidate points"]
        Stitch["**stitch**<br>link candidates<br>into trajectories"]

        Preprocess --> Detect --> Stitch
    end

    subgraph BaseClass["Shared Tracker Interface"]
        SetMetadata["Read metadata"]
        ToNetcdf["Write CF-NetCDF output"]
    end

    TrajList[("List of trajectories<br>(in python)")]
    OutputNC[("Output CF-NetCDF<br>trajectory file")]

    InputNC --> MLTracker
    InputNC --> SetMetadata
    MLParameters --> MLTracker
    MLTracker --> TrajList --> ToNetcdf
    SetMetadata --> ToNetcdf
    ToNetcdf --> OutputNC

    style User fill:#dae8fc,stroke:#6c8ebf
    style InputNC fill:#d5e8d4,stroke:#82b366
    style TrajList fill:#dae8fc,stroke:#6c8ebf
    style OutputNC fill:#dae8fc,stroke:#6c8ebf
    style MLParameters fill:#fdf6d8,stroke:#d6b656
    style MLTracker fill:#fde9d0,stroke:#d79b00
    style BaseClass fill:#d5e8d4,stroke:#82b366
    style Preprocess fill:#f5f5f5,stroke:#666,stroke-dasharray: 4 3
    style Detect fill:#f5f5f5,stroke:#666,stroke-dasharray: 4 3
    style Stitch fill:#f5f5f5,stroke:#666,stroke-dasharray: 4 3
